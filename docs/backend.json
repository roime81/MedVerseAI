{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "Represents a user of the application with a specific role.",
      "properties": {
        "uid": { "type": "string", "description": "Unique user ID from Firebase Auth." },
        "email": { "type": "string", "format": "email", "description": "User's email address." },
        "role": {
          "type": "string",
          "enum": ["physician", "nurse", "radiology", "lab", "billing", "admin", "pharmacist"],
          "description": "The role of the user, which determines their permissions and dashboard."
        },
        "displayName": { "type": "string", "description": "User's display name." }
      },
      "required": ["uid", "email", "role"]
    },
    "Patient": {
      "title": "Patient",
      "type": "object",
      "description": "Represents a patient's demographic and identifying information.",
      "properties": {
        "personId": {
          "type": "string",
          "description": "Unique identifier for the Patient entity."
        },
        "nationalId": {
          "type": "string",
          "description": "Government-issued identifier."
        },
        "fullName": {
          "type": "string",
          "description": "Patient's full name."
        },
        "dateOfBirth": {
          "type": "string",
          "format": "date",
          "description": "Patient's date of birth."
        },
        "gender": {
          "type": "string",
          "description": "Gender of the patient."
        },
        "race": {
          "type": "string",
          "description": "Race classification of the patient."
        },
        "ethnicity": {
          "type": "string",
          "description": "Ethnicity classification of the patient."
        },
        "maritalStatus": {
          "type": "string",
          "description": "Civil status of the patient."
        },
        "contactInfo": {
          "type": "string",
          "description": "Patient's phone or email."
        },
        "address": {
          "type": "string",
          "description": "Patient's full address."
        },
        "emergencyContact": {
          "type": "string",
          "description": "Emergency contact information."
        },
        "primaryProviderId": {
          "type": "string",
          "description": "Assigned primary care physician."
        },
        "insuranceNumber": {
          "type": "string",
          "description": "Link to insurance table."
        },
        "allergyFlag": {
          "type": "string",
          "description": "Summary for clinical decision support."
        },
        "activeProblemList": {
          "type": "string",
          "description": "Summary for clinical decision support."
        }
      },
      "required": [
        "personId",
        "fullName",
        "dateOfBirth"
      ]
    },
    "Encounter": {
      "title": "Encounter",
      "type": "object",
      "description": "Represents a patient encounter or visit.",
      "properties": {
        "encounterId": {
          "type": "string",
          "description": "Unique identifier for the Encounter entity."
        },
        "personId": {
          "type": "string",
          "description": "Link to the Patient."
        },
        "facilityId": {
          "type": "string",
          "description": "Hospital or clinic unit where the encounter occurred."
        },
        "encounterType": {
          "type": "string",
          "description": "Type of visit (inpatient, outpatient, emergency)."
        },
        "admissionDatetime": {
          "type": "string",
          "format": "date-time",
          "description": "Start time of the visit."
        },
        "dischargeDatetime": {
          "type": "string",
          "format": "date-time",
          "description": "End time of the visit."
        },
        "attendingProviderId": {
          "type": "string",
          "description": "Doctor in charge of the visit."
        },
        "visitReason": {
          "type": "string",
          "description": "The initial reason for the visit."
        },
        "visitStatus": {
          "type": "string",
          "description": "Status of the visit (e.g., Active, Discharged)."
        }
      },
      "required": [
        "encounterId",
        "personId"
      ]
    },
    "Condition": {
      "title": "Condition",
      "type": "object",
      "description": "Represents a patient's medical condition or diagnosis.",
      "properties": {
        "diagnosisId": {
          "type": "string",
          "description": "Unique identifier for the Diagnosis entity."
        },
        "personId": {
          "type": "string",
          "description": "Link to the Patient."
        },
        "encounterId": {
          "type": "string",
          "description": "Link to the Encounter when diagnosed."
        },
        "icd10Code": {
          "type": "string",
          "description": "ICD-10 or SNOMED code for the condition."
        },
        "diagnosisType": {
          "type": "string",
          "description": "Principal or Secondary diagnosis."
        },
        "onsetDate": {
          "type": "string",
          "format": "date",
          "description": "Onset date of the condition."
        },
        "resolutionDate": {
          "type": "string",
          "format": "date",
          "description": "Resolution date of the condition."
        },
        "status": {
          "type": "string",
          "description": "Active or Resolved."
        },
        "certainty": {
          "type": "string",
          "description": "Confirmed or Suspected."
        }
      },
      "required": [
        "diagnosisId",
        "personId"
      ]
    },
    "DrugExposure": {
      "title": "DrugExposure",
      "type": "object",
      "description": "Represents a patient's drug exposure or medication.",
      "properties": {
        "medicationId": {
          "type": "string",
          "description": "Unique identifier for the Medication order."
        },
        "personId": {
          "type": "string",
          "description": "Link to the Patient."
        },
        "encounterId": {
          "type": "string",
          "description": "Link to the Encounter when prescribed."
        },
        "drugCode": {
          "type": "string",
          "description": "RxNorm / ATC code for the drug."
        },
        "drugName": {
          "type": "string",
          "description": "Name of the medication."
        },
        "dose": {
          "type": "string",
          "description": "Dosage details (e.g., '10mg')."
        },
        "startDate": {
          "type": "string",
          "format": "date-time",
          "description": "Start time of the drug exposure."
        },
        "endDate": {
          "type": "string",
          "format": "date-time",
          "description": "End time of the drug exposure."
        },
        "prescribingPhysicianId": {
          "type": "string",
          "description": "ID of the prescribing doctor."
        },
        "dispenseStatus": {
          "type": "string",
          "description": "Dispensed or Not dispensed."
        }
      },
      "required": [
        "medicationId",
        "personId"
      ]
    },
    "Bed": {
      "title": "Bed",
      "type": "object",
      "description": "Represents a bed in a healthcare facility for occupancy management.",
      "properties": {
        "bedId": {
          "type": "string",
          "description": "Unique identifier for the Bed entity."
        },
        "location": {
          "type": "string",
          "description": "The physical location of the bed (e.g., Ward A, Room 101)."
        },
        "status": {
          "type": "string",
          "enum": [
            "Occupied",
            "Available",
            "Maintenance"
          ],
          "description": "The current status of the bed."
        },
        "patientId": {
          "type": "string",
          "description": "Identifier of the patient currently occupying the bed, if any."
        },
        "careSiteId": {
          "type": "string",
          "description": "Identifier for the hospital or clinic site."
        }
      },
      "required": [
        "bedId",
        "location",
        "status"
      ]
    },
    "CareSite": {
      "title": "CareSite",
      "type": "object",
      "description": "Represents a healthcare facility or hospital.",
      "properties": {
        "careSiteId": {
          "type": "string",
          "description": "Unique identifier for the CareSite entity (hospital code)."
        },
        "careSiteName": {
          "type": "string",
          "description": "The official name of the hospital or care site."
        }
      },
      "required": [
        "careSiteId",
        "careSiteName"
      ]
    },
    "Cost": {
      "title": "Cost",
      "type": "object",
      "description": "Represents billing and cost information for a clinical event.",
      "properties": {
        "chargeId": {
          "type": "string",
          "description": "Unique identifier for the charge line."
        },
        "personId": {
          "type": "string",
          "description": "Identifier of the patient associated with this cost."
        },
        "encounterId": {
          "type": "string",
          "description": "ID of the encounter this cost is for."
        },
        "serviceCode": {
          "type": "string",
          "description": "Local or CPT code for the service."
        },
        "description": {
          "type": "string",
          "description": "Description of the service or item."
        },
        "totalCharge": {
          "type": "number",
          "description": "The total charge for the event."
        },
        "patientResponsibility": {
          "type": "number",
          "description": "Amount paid by the patient (copay, deductible)."
        },
        "paymentStatus": {
          "type": "string",
          "description": "Pending, Paid, or Denied."
        },
        "claimId": {
          "type": "string",
          "description": "Link to the claim submission."
        }
      },
      "required": [
        "chargeId",
        "personId",
        "encounterId"
      ]
    },
    "PayerPlanPeriod": {
      "title": "PayerPlanPeriod",
      "type": "object",
      "description": "Represents a patient's insurance coverage timeline.",
      "properties": {
        "planId": {
          "type": "string",
          "description": "Unique identifier for the PayerPlanPeriod entity."
        },
        "personId": {
          "type": "string",
          "description": "Identifier of the patient."
        },
        "payerId": {
          "type": "string",
          "description": "ID of the insurance company."
        },
        "coverageStartDate": {
          "type": "string",
          "format": "date",
          "description": "Start date of the coverage."
        },
        "coverageEndDate": {
          "type": "string",
          "format": "date",
          "description": "End date of the coverage."
        },
        "policyNumber": {
          "type": "string",
          "description": "Policy identifier."
        }
      },
      "required": [
        "planId",
        "personId",
        "coverageStartDate"
      ]
    },
    "VisitDetail": {
      "title": "VisitDetail",
      "type": "object",
      "description": "Represents a specific claim line within a patient visit.",
      "properties": {
        "visitDetailId": {
          "type": "string",
          "description": "Unique identifier for the VisitDetail entity."
        },
        "personId": {
          "type": "string",
          "description": "Identifier of the patient."
        },
        "encounterId": {
          "type": "string",
          "description": "Identifier of the parent visit/encounter."
        },
        "serviceCode": {
          "type": "string",
          "description": "Concept identifying the service or product on the claim line."
        },
        "serviceDate": {
          "type": "string",
          "format": "date",
          "description": "Start date of the service on the claim line."
        }
      },
      "required": [
        "visitDetailId",
        "personId",
        "encounterId"
      ]
    },
    "ClinicalNote": {
      "title": "ClinicalNote",
      "type": "object",
      "description": "Represents clinical documentation like doctor or nurse notes.",
      "properties": {
        "noteId": {
          "type": "string",
          "description": "Unique identifier for the note."
        },
        "encounterId": {
          "type": "string",
          "description": "Link to the Encounter."
        },
        "authorId": {
          "type": "string",
          "description": "ID of the clinician who wrote the note."
        },
        "noteType": {
          "type": "string",
          "description": "SOAP, Progress, Admission, Discharge."
        },
        "noteText": {
          "type": "string",
          "description": "The unstructured text of the note."
        },
        "dateTimeCreated": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the note was created."
        }
      },
      "required": [
        "noteId",
        "encounterId"
      ]
    },
    "Procedure": {
      "title": "Procedure",
      "type": "object",
      "description": "Represents a medical procedure or operation.",
      "properties": {
        "procedureId": {
          "type": "string",
          "description": "Unique identifier for the procedure."
        },
        "personId": {
          "type": "string",
          "description": "Link to the Patient."
        },
        "encounterId": {
          "type": "string",
          "description": "Link to the Encounter."
        },
        "procedureCode": {
          "type": "string",
          "description": "CPT/ICD-9/10-PCS code for the procedure."
        },
        "procedureName": {
          "type": "string",
          "description": "Description of the procedure."
        },
        "procedureDateTime": {
          "type": "string",
          "format": "date-time",
          "description": "Date and time the procedure was performed."
        },
        "performingClinicianId": {
          "type": "string",
          "description": "ID of the clinician who performed the procedure."
        }
      },
      "required": [
        "procedureId",
        "personId"
      ]
    },
    "LabResult": {
      "title": "LabResult",
      "type": "object",
      "description": "Represents a laboratory or diagnostic test result.",
      "properties": {
        "labOrderId": {
          "type": "string",
          "description": "Unique identifier for the lab order."
        },
        "personId": {
          "type": "string",
          "description": "Link to the Patient."
        },
        "encounterId": {
          "type": "string",
          "description": "Link to the Encounter."
        },
        "testCode": {
          "type": "string",
          "description": "LOINC code for the test."
        },
        "resultValue": {
          "type": "string",
          "description": "The resulting value of the test."
        },
        "resultDate": {
          "type": "string",
          "format": "date-time",
          "description": "Date and time the result was available."
        },
        "resultFlag": {
          "type": "string",
          "description": "Flag for the result (e.g., High, Low, Normal)."
        }
      },
      "required": [
        "labOrderId",
        "personId"
      ]
    },
    "ImagingStudy": {
      "title": "ImagingStudy",
      "type": "object",
      "description": "Represents an imaging or radiology order.",
      "properties": {
        "imagingOrderId": {
          "type": "string",
          "description": "Unique identifier for the imaging order."
        },
        "personId": {
          "type": "string",
          "description": "Link to the Patient."
        },
        "encounterId": {
          "type": "string",
          "description": "Link to the Encounter."
        },
        "modality": {
          "type": "string",
          "description": "CT, MRI, X-ray, etc."
        },
        "procedureCode": {
          "type": "string",
          "description": "LOINC or RadLex code for the study."
        },
        "impression": {
          "type": "string",
          "description": "Key findings from the radiologist."
        }
      },
      "required": [
        "imagingOrderId",
        "personId"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Stores user profiles and roles."
    },
    "/patients/{patientId}": {
      "schema": {
        "$ref": "#/entities/Patient"
      },
      "description": "Stores individual patient records."
    },
    "/patients/{patientId}/encounters/{encounterId}": {
      "schema": {
        "$ref": "#/entities/Encounter"
      },
      "description": "Sub-collection for a patient's encounters."
    },
    "/patients/{patientId}/conditions/{conditionId}": {
      "schema": {
        "$ref": "#/entities/Condition"
      },
      "description": "Sub-collection for a patient's conditions."
    },
    "/patients/{patientId}/drugExposures/{drugExposureId}": {
      "schema": {
        "$ref": "#/entities/DrugExposure"
      },
      "description": "Sub-collection for a patient's drug exposures."
    },
    "/patients/{patientId}/costs/{costId}": {
      "schema": {
        "$ref": "#/entities/Cost"
      },
      "description": "Sub-collection for a patient's billing costs."
    },
    "/patients/{patientId}/payerPlanPeriods/{payerPlanPeriodId}": {
      "schema": {
        "$ref": "#/entities/PayerPlanPeriod"
      },
      "description": "Sub-collection for a patient's insurance coverage history."
    },
    "/patients/{patientId}/visitDetails/{visitDetailId}": {
      "schema": {
        "$ref": "#/entities/VisitDetail"
      },
      "description": "Sub-collection for a patient's visit claim line details."
    },
    "/patients/{patientId}/clinicalNotes/{noteId}": {
      "schema": {
        "$ref": "#/entities/ClinicalNote"
      },
      "description": "Sub-collection for a patient's clinical notes."
    },
    "/patients/{patientId}/procedures/{procedureId}": {
      "schema": {
        "$ref": "#/entities/Procedure"
      },
      "description": "Sub-collection for a patient's procedures."
    },
    "/patients/{patientId}/labResults/{labResultId}": {
      "schema": {
        "$ref": "#/entities/LabResult"
      },
      "description": "Sub-collection for a patient's lab results."
    },
    "/patients/{patientId}/imagingStudies/{imagingStudyId}": {
      "schema": {
        "$ref": "#/entities/ImagingStudy"
      },
      "description": "Sub-collection for a patient's imaging studies."
    },
    "/beds/{bedId}": {
      "schema": {
        "$ref": "#/entities/Bed"
      },
      "description": "Stores bed occupancy and management information for a facility."
    },
    "/careSites/{careSiteId}": {
      "schema": {
        "$ref": "#/entities/CareSite"
      },
      "description": "Stores information about healthcare facilities (hospitals)."
    },
    "/procedures/{procedureId}": {
      "schema": {
        "$ref": "#/entities/Procedure"
      },
      "description": "Top-level collection of all procedures."
    }
  },
  "auth": {
    "providers": [
      "google"
    ]
  }
}

    
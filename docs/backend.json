{
  "entities": {
    "PersonMaster": {
      "title": "Person Master",
      "type": "object",
      "description": "Golden record for a person, uniquely identified. Based on OMOP Person and FHIR Patient resources.",
      "properties": {
        "person_id": {
          "type": "string",
          "description": "Surrogate primary key for the person (UUID)."
        },
        "birth_datetime": {
          "type": "string",
          "format": "date-time",
          "description": "The date and time of birth."
        },
        "sex_at_birth_concept_id": {
          "type": "number",
          "description": "OMOP concept ID for sex at birth."
        },
        "gender_identity_concept_id": {
          "type": "number",
          "description": "OMOP concept ID for gender identity."
        },
        "race_concept_id": {
          "type": "number",
          "description": "OMOP concept ID for race."
        },
        "ethnicity_concept_id": {
          "type": "number",
          "description": "OMOP concept ID for ethnicity."
        },
        "deceased_datetime": {
          "type": "string",
          "format": "date-time",
          "description": "The date and time of death."
        },
        "active_flag": {
          "type": "boolean",
          "description": "Whether this person record is active."
        }
      },
      "required": ["person_id", "active_flag"]
    },
    "PersonIdentifier": {
      "title": "Person Identifier",
      "type": "object",
      "description": "An identifier for a person, such as MRN, national ID, etc.",
      "properties": {
        "person_identifier_id": {
          "type": "string",
          "description": "Primary key for the identifier (UUID)."
        },
        "person_id": {
          "type": "string",
          "description": "FK to the person_master record."
        },
        "system_uri": {
          "type": "string",
          "description": "URI identifying the identifier system (e.g., MRN)."
        },
        "value": {
          "type": "string",
          "description": "The value of the identifier."
        },
        "use": {
          "type": "string",
          "description": "The use of the identifier (e.g., official, temp)."
        },
        "is_primary": {
          "type": "boolean",
          "description": "Is this the primary identifier for this system?"
        }
      },
      "required": ["person_identifier_id", "person_id", "system_uri", "value"]
    },
    "Coverage": {
      "title": "Coverage",
      "type": "object",
      "description": "Insurance coverage for a person.",
      "properties": {
        "coverage_id": { "type": "string", "description": "Primary key (UUID)." },
        "person_id": { "type": "string", "description": "FK to person_master." },
        "status": { "type": "string", "enum": ["active", "cancelled", "draft", "entered-in-error"] },
        "payor": { "type": "string", "description": "Name of the insurance company." },
        "subscriberId": { "type": "string", "description": "The subscriber ID." },
        "period_start": { "type": "string", "format": "date-time" },
        "period_end": { "type": "string", "format": "date-time" }
      },
      "required": ["coverage_id", "person_id", "status", "payor"]
    },
    "Claim": {
      "title": "Claim",
      "type": "object",
      "description": "A claim for services rendered.",
      "properties": {
        "claim_id": { "type": "string", "description": "Primary key (UUID)." },
        "person_id": { "type": "string", "description": "FK to person_master." },
        "status": { "type": "string", "enum": ["active", "cancelled", "draft", "entered-in-error"] },
        "total": { "type": "number", "description": "The total amount of the claim." },
        "created": { "type": "string", "format": "date-time" },
        "provider_id": { "type": "string", "description": "FK to practitioner/organization." }
      },
      "required": ["claim_id", "person_id", "status", "total"]
    },
    "ExplanationOfBenefit": {
      "title": "Explanation of Benefit",
      "type": "object",
      "description": "An Explanation of Benefit (EOB) from an insurer.",
      "properties": {
        "eob_id": { "type": "string", "description": "Primary key (UUID)." },
        "claim_id": { "type": "string", "description": "FK to the claim." },
        "status": { "type": "string", "enum": ["active", "cancelled", "draft", "entered-in-error"] },
        "total": { "type": "number", "description": "Total amount covered." },
        "payment_date": { "type": "string", "format": "date" }
      },
      "required": ["eob_id", "claim_id", "status"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/person_master/{personId}",
        "definition": {
          "entityName": "PersonMaster",
          "schema": {
            "$ref": "#/backend/entities/PersonMaster"
          },
          "description": "Stores the master record for each person. Access is restricted."
        }
      },
      {
        "path": "/person_master/{personId}/identifiers/{identifierId}",
        "definition": {
          "entityName": "PersonIdentifier",
          "schema": {
            "$ref": "#/backend/entities/PersonIdentifier"
          },
          "description": "Stores identifiers associated with a person."
        }
      },
      {
        "path": "/person_master/{personId}/coverage/{coverageId}",
        "definition": {
          "entityName": "Coverage",
          "schema": { "$ref": "#/backend/entities/Coverage" },
          "description": "Stores patient insurance coverage."
        }
      },
      {
        "path": "/claims/{claimId}",
        "definition": {
          "entityName": "Claim",
          "schema": { "$ref": "#/backend/entities/Claim" },
          "description": "Stores claims for all patients."
        }
      },
      {
        "path": "/eobs/{eobId}",
        "definition": {
          "entityName": "ExplanationOfBenefit",
          "schema": { "$ref": "#/backend/entities/ExplanationOfBenefit" },
          "description": "Stores EOBs for all claims."
        }
      }
    ],
    "reasoning": "This structure aligns with the FHIR/OMOP data model provided. It establishes a master 'person' collection to act as the single source of truth (golden record). Identifiers and coverage are stored in a sub-collection, allowing for multiple per person while maintaining a clean data hierarchy. Claims and EOBs are in root collections for easier querying across all patients. Authorization can be managed at the appropriate levels."
  }
}

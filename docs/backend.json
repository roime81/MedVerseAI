{
  "entities": {
    "Patient": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Patient",
      "type": "object",
      "description": "Represents a patient's medical record summary and related information.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the Patient entity." },
        "name": { "type": "string", "description": "The full name of the patient." },
        "ward": { "type": "string" },
        "hospital": { "type": "string" },
        "consultant": { "type": "string" },
        "status": { "type": "string", "enum": ["Occupied", "Discharging", "Admitted"] },
        "mrn": { "type": "string" },
        "lastSeen": { "type": "string" },
        "alerts": { "type": "number" },
        "dob": { "type": "string", "format": "date" },
        "gender": { "type": "string", "enum": ["Male", "Female", "Other"] },
        "ssnLast4": { "type": "string" },
        "maritalStatus": { "type": "string", "enum": ["Married", "Single", "Divorced", "Widowed"] },
        "contact": {
          "type": "object",
          "properties": {
            "phone": { "type": "string" },
            "email": { "type": "string", "format": "email" },
            "address": {
              "type": "object",
              "properties": {
                "line1": { "type": "string" },
                "city": { "type": "string" },
                "state": { "type": "string" },
                "zip": { "type": "string" }
              }
            }
          }
        },
        "emergencyContact": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "phone": { "type": "string" }
          }
        },
        "insurance": {
          "type": "object",
          "properties": {
            "provider": { "type": "string" },
            "policyNumber": { "type": "string" },
            "groupNumber": { "type": "string" },
            "status": { "type": "string", "enum": ["Active", "Inactive"] }
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "stage": { "type": "string" },
              "code": { "type": "string" },
              "diagnosedDate": { "type": "string", "format": "date" }
            }
          }
        },
        "vitals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": { "type": "string", "format": "date-time" },
              "bloodPressure": { "type": "string" },
              "heartRate": { "type": "string" },
              "temperature": { "type": "string" },
              "weight": { "type": "string" },
              "height": { "type": "string" },
              "bmi": { "type": "string" }
            }
          }
        },
        "medications": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "dosage": { "type": "string" },
              "frequency": { "type": "string" },
              "prescriber": { "type": "string" },
              "remaining": { "type": "number" },
              "startDate": { "type": "string" }
            }
          }
        },
        "labResults": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "date": { "type": "string", "format": "date-time" },
              "result": { "type": "string" },
              "reference": { "type": "string" },
              "status": { "type": "string", "enum": ["Normal", "Elevated", "Low"] }
            }
          }
        },
        "visitHistory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "date": { "type": "string", "format": "date-time" },
              "doctor": { "type": "string" },
              "chiefComplaint": { "type": "string" },
              "diagnosis": { "type": "string" },
              "notes": { "type": "string" }
            }
          }
        },
        "immunizationHistory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "vaccine": { "type": "string" },
              "date": { "type": "string", "format": "date-time" },
              "administeredBy": { "type": "string" }
            }
          }
        },
        "socialHistory": {
          "type": "object",
          "properties": {
            "smokingStatus": { "type": "string" },
            "alcoholUse": { "type": "string" },
            "exercise": { "type": "string" },
            "occupation": { "type": "string" }
          }
        },
        "familyHistory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "relation": { "type": "string" },
              "condition": { "type": "string" },
              "notes": { "type": "string" }
            }
          }
        }
      },
      "required": [ "id", "name" ]
    },
    "Ward": {
      "title": "Ward",
      "type": "object",
      "description": "Represents a hospital ward.",
      "properties": {
        "name": { "type": "string" },
        "hospital": { "type": "string" },
        "totalBeds": { "type": "number" },
        "occupiedBeds": { "type": "number" }
      },
      "required": ["name", "hospital", "totalBeds", "occupiedBeds"]
    },
    "Task": {
        "title": "Task",
        "type": "object",
        "description": "Represents a task for a physician.",
        "properties": {
            "description": { "type": "string" },
            "patient": { "type": "string" },
            "mrn": { "type": "string" },
            "time": { "type": "string" },
            "priority": { "type": "string", "enum": ["High", "Medium", "Low"] }
        },
        "required": ["description", "patient", "mrn", "time", "priority"]
    },
     "StaffProfile": {
      "title": "StaffProfile",
      "type": "object",
      "description": "Represents a staff member's profile.",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "avatarId": { "type": "string" }
      },
      "required": ["name", "role", "email", "avatarId"]
    },
    "Claim": {
      "title": "Claim",
      "type": "object",
      "description": "Represents a billing claim.",
      "properties": {
        "id": { "type": "string" },
        "patient": { "type": "string" },
        "created": { "type": "string", "format": "date" },
        "total": { "type": "number" },
        "provider": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "cancelled", "draft", "entered-in-error"] }
      },
      "required": ["id", "patient", "created", "total", "provider", "status"]
    },
    "ImagingStudy": {
      "title": "ImagingStudy",
      "type": "object",
      "description": "Represents a medical imaging study.",
      "properties": {
        "id": { "type": "string" },
        "patient": { "type": "string" },
        "study": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "imageUrl": { "type": "string" },
        "imageHint": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "patient", "study", "date", "imageUrl"]
    },
    "TelehealthAppointment": {
      "title": "TelehealthAppointment",
      "type": "object",
      "description": "Represents a telehealth appointment.",
      "properties": {
        "patientName": { "type": "string" },
        "time": { "type": "string" },
        "status": { "type": "string", "enum": ["Upcoming", "Waiting", "Completed"] },
        "avatarId": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["patientName", "time", "status", "avatarId"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/patients/{patientId}",
        "definition": {
          "schema": { "$ref": "#/backend/entities/Patient" },
          "description": "Stores individual patient records."
        }
      },
      {
        "path": "/wards/{wardId}",
        "definition": {
          "schema": { "$ref": "#/backend/entities/Ward" },
          "description": "Stores information about hospital wards."
        }
      },
      {
        "path": "/tasks/{taskId}",
        "definition": {
          "schema": { "$ref": "#/backend/entities/Task" },
          "description": "Stores tasks for medical staff."
        }
      },
      {
        "path": "/staffProfiles/{staffProfileId}",
        "definition": {
            "schema": { "$ref": "#/backend/entities/StaffProfile" },
            "description": "Stores staff profile information."
        }
      },
      {
        "path": "/claims/{claimId}",
        "definition": {
          "schema": { "$ref": "#/backend/entities/Claim" },
          "description": "Stores billing claims."
        }
      },
      {
        "path": "/imagingStudies/{studyId}",
        "definition": {
          "schema": { "$ref": "#/backend/entities/ImagingStudy" },
          "description": "Stores medical imaging studies."
        }
      },
      {
        "path": "/telehealthAppointments/{appointmentId}",
        "definition": {
          "schema": { "$ref": "#/backend/entities/TelehealthAppointment" },
          "description": "Stores telehealth appointments."
        }
      }
    ]
  }
}

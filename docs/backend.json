{
  "entities": {
    "Patient": {
      "title": "Patient",
      "type": "object",
      "description": "Represents a patient's demographic and identifying information.",
      "properties": {
        "personId": {
          "type": "string",
          "description": "Unique identifier for the Patient entity."
        },
        "genderConceptId": {
          "type": "string",
          "description": "Gender concept of the patient."
        },
        "yearOfBirth": {
          "type": "number",
          "description": "The year the patient was born."
        },
        "monthOfBirth": {
          "type": "number",
          "description": "The month the patient was born."
        },
        "dayOfBirth": {
          "type": "number",
          "description": "The day the patient was born."
        },
        "raceConceptId": {
          "type": "string",
          "description": "Race classification of the patient."
        },
        "ethnicityConceptId": {
          "type": "string",
          "description": "Ethnicity classification of the patient."
        },
        "locationId": {
          "type": "string",
          "description": "Link to the patient's address."
        },
        "providerId": {
          "type": "string",
          "description": "Primary care provider for the patient."
        },
        "careSiteId": {
          "type": "string",
          "description": "Hospital or clinic site associated with the patient."
        }
      },
      "required": [
        "personId"
      ]
    },
    "Encounter": {
      "title": "Encounter",
      "type": "object",
      "description": "Represents a patient encounter or visit.",
      "properties": {
        "visitOccurrenceId": {
          "type": "string",
          "description": "Unique identifier for the Encounter entity."
        },
        "personId": {
          "type": "string",
          "description": "Link to the Patient."
        },
        "visitConceptId": {
          "type": "string",
          "description": "Type of visit (inpatient, outpatient, emergency)."
        },
        "visitStartDatetime": {
          "type": "string",
          "format": "date-time",
          "description": "Start time of the visit."
        },
        "visitEndDatetime": {
          "type": "string",
          "format": "date-time",
          "description": "End time of the visit."
        },
        "careSiteId": {
          "type": "string",
          "description": "Facility where the encounter occurred."
        }
      },
      "required": [
        "visitOccurrenceId",
        "personId"
      ]
    },
    "Condition": {
      "title": "Condition",
      "type": "object",
      "description": "Represents a patient's medical condition or diagnosis.",
      "properties": {
        "conditionOccurrenceId": {
          "type": "string",
          "description": "Unique identifier for the Condition entity."
        },
        "personId": {
          "type": "string",
          "description": "Link to the Patient."
        },
        "conditionConceptId": {
          "type": "string",
          "description": "SNOMED/ICD-10 code for the condition."
        },
        "conditionStartDate": {
          "type": "string",
          "format": "date",
          "description": "Onset date of the condition."
        },
        "conditionEndDate": {
          "type": "string",
          "format": "date",
          "description": "Resolution date of the condition."
        }
      },
      "required": [
        "conditionOccurrenceId",
        "personId"
      ]
    },
    "Observation": {
      "title": "Observation",
      "type": "object",
      "description": "Represents a clinical observation about a patient.",
      "properties": {
        "observationId": {
          "type": "string",
          "description": "Unique identifier for the Observation entity."
        },
        "personId": {
          "type": "string",
          "description": "Link to the Patient."
        },
        "observationConceptId": {
          "type": "string",
          "description": "Type of observation."
        },
        "observationDate": {
          "type": "string",
          "format": "date-time",
          "description": "Date and time of the observation."
        },
        "valueAsNumber": {
          "type": "number",
          "description": "Numeric result of the observation."
        },
        "valueAsString": {
          "type": "string",
          "description": "String result of the observation."
        },
        "unitConceptId": {
          "type": "string",
          "description": "Unit of measurement for the observation."
        }
      },
      "required": [
        "observationId",
        "personId"
      ]
    },
    "Measurement": {
      "title": "Measurement",
      "type": "object",
      "description": "Represents a vital sign or lab measurement.",
      "properties": {
        "measurementId": {
          "type": "string",
          "description": "Unique identifier for the Measurement entity."
        },
        "personId": {
          "type": "string",
          "description": "Link to the Patient."
        },
        "measurementConceptId": {
          "type": "string",
          "description": "LOINC code for the measurement."
        },
        "measurementDatetime": {
          "type": "string",
          "format": "date-time",
          "description": "Date and time of the measurement."
        },
        "valueAsNumber": {
          "type": "number",
          "description": "Numeric result of the measurement."
        },
        "unitConceptId": {
          "type": "string",
          "description": "Unit of measurement (mmHg, mmol/L)."
        }
      },
      "required": [
        "measurementId",
        "personId"
      ]
    },
    "DrugExposure": {
      "title": "DrugExposure",
      "type": "object",
      "description": "Represents a patient's drug exposure or medication.",
      "properties": {
        "drugExposureId": {
          "type": "string",
          "description": "Unique identifier for the DrugExposure entity."
        },
        "personId": {
          "type": "string",
          "description": "Link to the Patient."
        },
        "drugConceptId": {
          "type": "string",
          "description": "RxNorm / ATC code for the drug."
        },
        "drugExposureStartDatetime": {
          "type": "string",
          "format": "date-time",
          "description": "Start time of the drug exposure."
        },
        "drugExposureEndDatetime": {
          "type": "string",
          "format": "date-time",
          "description": "End time of the drug exposure."
        },
        "doseUnitConceptId": {
          "type": "string",
          "description": "Unit of measurement for the drug dose (mg, ml)."
        }
      },
      "required": [
        "drugExposureId",
        "personId"
      ]
    },
    "Bed": {
      "title": "Bed",
      "type": "object",
      "description": "Represents a bed in a healthcare facility for occupancy management.",
      "properties": {
        "bedId": {
          "type": "string",
          "description": "Unique identifier for the Bed entity."
        },
        "location": {
          "type": "string",
          "description": "The physical location of the bed (e.g., Ward A, Room 101)."
        },
        "status": {
          "type": "string",
          "enum": [
            "Occupied",
            "Available",
            "Maintenance"
          ],
          "description": "The current status of the bed."
        },
        "patientId": {
          "type": "string",
          "description": "Identifier of the patient currently occupying the bed, if any."
        },
        "careSiteId": {
          "type": "string",
          "description": "Identifier for the hospital or clinic site."
        }
      },
      "required": [
        "bedId",
        "location",
        "status"
      ]
    }
  },
  "firestore": {
    "/patients/{patientId}": {
      "schema": {
        "$ref": "#/entities/Patient"
      },
      "description": "Stores individual patient records."
    },
    "/patients/{patientId}/encounters/{encounterId}": {
      "schema": {
        "$ref": "#/entities/Encounter"
      },
      "description": "Sub-collection for a patient's encounters."
    },
    "/patients/{patientId}/conditions/{conditionId}": {
      "schema": {
        "$ref": "#/entities/Condition"
      },
      "description": "Sub-collection for a patient's conditions."
    },
    "/patients/{patientId}/observations/{observationId}": {
      "schema": {
        "$ref": "#/entities/Observation"
      },
      "description": "Sub-collection for a patient's observations."
    },
    "/patients/{patientId}/measurements/{measurementId}": {
      "schema": {
        "$ref": "#/entities/Measurement"
      },
      "description": "Sub-collection for a patient's measurements."
    },
    "/patients/{patientId}/drugExposures/{drugExposureId}": {
      "schema": {
        "$ref": "#/entities/DrugExposure"
      },
      "description": "Sub-collection for a patient's drug exposures."
    },
    "/beds/{bedId}": {
      "schema": {
        "$ref": "#/entities/Bed"
      },
      "description": "Stores bed occupancy and management information for a facility."
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  }
}

/**
 * @fileoverview Firestore Security Rules for the distributed health information system.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for personal data (patients, physicians).
 * Access to other resources (facilities, medications, beds, telehealth sessions, image studies)
 * is managed through resource-based ownership or explicit relationships. The rules are designed to be
 * easily auditable and maintainable.
 *
 * Data Structure:
 * - /patients/{patientId}: Patient records, accessible only by the patient themselves.
 * - /patients/{patientId}/appointments/{appointmentId}: Appointments for a specific patient,
 *   potentially accessible to the patient and associated physician (via denormalized physicianId).
 * - /physicians/{physicianId}: Physician profiles, accessible only by the physician themselves.
 * - /facilities/{facilityId}: Facility information.
 * - /facilities/{facilityId}/beds/{bedId}: Beds within a facility.
 * - /medications/{medicationId}: Medication information.
 * - /telehealthSessions/{telehealthSessionId}: Telehealth sessions, potentially accessible to
 *   the patient and physician involved.
 * - /patients/{patientId}/imageStudies/{imageStudyId}: Image studies for a specific patient.
 *
 * Key Security Decisions:
 * - Users can only create, read, update, and delete their own patient and physician records.
 * - Listing of all patients or physicians is disallowed to prevent data scraping.
 * - Access to appointments, telehealth sessions, and image studies requires explicit relationships
 *   (patientId, physicianId) and may involve denormalized data for efficient rule enforcement.
 * - Facilities and medications are publicly readable but not writable by clients.
 *
 * Denormalization for Authorization:
 * To avoid costly `get()` calls, the following denormalizations are recommended:
 * - Appointment documents should include both `patientId` and `physicianId`.
 * - TelehealthSession documents should include both `patientId` and `physicianId`,
 *   and potentially facility attributes if facility-level access control is needed.
 *
 * Structural Segregation:
 * The data is segregated into collections based on access requirements, ensuring that list
 * operations can be securely performed without filtering.
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user ID matches the provided user ID.
     * @param {string} userId - The user ID to compare against the authenticated user's ID.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the existing owner of a document.
     * @param {string} userId - The user ID to compare against the authenticated user's ID.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Defines the rules for patient documents.
     * @path /patients/{patientId}
     * @allow (create) - Authenticated user can create a patient document if the patientId matches their UID and the document `id` field matches the `patientId` path parameter.
     * @allow (read) - Authenticated user can read their own patient document.
     * @allow (update) - Authenticated user can update their own patient document.
     * @allow (delete) - Authenticated user can delete their own patient document.
     * @deny (create) - Authenticated user cannot create a patient document if the patientId does not match their UID.
     * @deny (read) - Authenticated user cannot read another user's patient document.
     * @deny (update) - Authenticated user cannot update another user's patient document.
     * @deny (delete) - Authenticated user cannot delete another user's patient document.
     * @principle Enforces document ownership for writes and reads based on user ID.
     */
    match /patients/{patientId} {
      allow get: if isOwner(patientId);
      allow list: if false; // Prevent listing all patients

      allow create: if isOwner(patientId) && request.resource.data.id == patientId;
      allow update: if isExistingOwner(patientId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(patientId);
    }

    /**
     * @description Defines the rules for appointment documents within a patient's subcollection.
     * @path /patients/{patientId}/appointments/{appointmentId}
     * @allow (create) - Authenticated user can create an appointment document under their patient document if they are the patient.
     * @allow (read) - Authenticated user can read an appointment document under their patient document if they are the patient.
     * @allow (update) - Authenticated user can update an appointment document under their patient document if they are the patient.
     * @allow (delete) - Authenticated user can delete an appointment document under their patient document if they are the patient.
     * @deny (create) - Authenticated user cannot create an appointment document if they are not the patient.
     * @deny (read) - Authenticated user cannot read an appointment document if they are not the patient.
     * @deny (update) - Authenticated user cannot update an appointment document if they are not the patient.
     * @deny (delete) - Authenticated user cannot delete an appointment document if they are not the patient.
     * @principle Restricts access to appointment documents to the associated patient.
     */
    match /patients/{patientId}/appointments/{appointmentId} {
      allow get: if isOwner(patientId);
      allow list: if isOwner(patientId);

      allow create: if isOwner(patientId) && request.resource.data.patientId == patientId;
      allow update: if isExistingOwner(patientId) && request.resource.data.patientId == resource.data.patientId;
      allow delete: if isExistingOwner(patientId);
    }

    /**
     * @description Defines the rules for physician documents.
     * @path /physicians/{physicianId}
     * @allow (create) - Authenticated user can create a physician document if the physicianId matches their UID and the document `id` field matches the `physicianId` path parameter.
     * @allow (read) - Authenticated user can read their own physician document.
     * @allow (update) - Authenticated user can update their own physician document.
     * @allow (delete) - Authenticated user can delete their own physician document.
     * @deny (create) - Authenticated user cannot create a physician document if the physicianId does not match their UID.
     * @deny (read) - Authenticated user cannot read another user's physician document.
     * @deny (update) - Authenticated user cannot update another user's physician document.
     * @deny (delete) - Authenticated user cannot delete another user's physician document.
     * @principle Enforces document ownership for writes and reads based on user ID.
     */
    match /physicians/{physicianId} {
      allow get: if isOwner(physicianId);
      allow list: if false; // Prevent listing all physicians

      allow create: if isOwner(physicianId) && request.resource.data.id == physicianId;
      allow update: if isExistingOwner(physicianId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(physicianId);
    }

    /**
     * @description Defines the rules for bed documents within a facility's subcollection.
     * @path /facilities/{facilityId}/beds/{bedId}
     * @allow (read) - Anyone can read bed documents within a facility.
     * @allow (list) - Anyone can list bed documents within a facility.
     * @deny (create) - No one can create bed documents via the client.
     * @deny (update) - No one can update bed documents via the client.
     * @deny (delete) - No one can delete bed documents via the client.
     * @principle Allows public read access to beds, but restricts writes.
     */
    match /facilities/{facilityId}/beds/{bedId} {
      allow get: if true;
      allow list: if true;

      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Defines the rules for facility documents.
     * @path /facilities/{facilityId}
     * @allow (read) - Anyone can read facility documents.
     * @allow (list) - Anyone can list facility documents.
     * @deny (create) - No one can create facility documents via the client.
     * @deny (update) - No one can update facility documents via the client.
     * @deny (delete) - No one can delete facility documents via the client.
     * @principle Allows public read access to facilities, but restricts writes.
     */
    match /facilities/{facilityId} {
      allow get: if true;
      allow list: if true;

      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Defines the rules for medication documents.
     * @path /medications/{medicationId}
     * @allow (read) - Anyone can read medication documents.
     * @allow (list) - Anyone can list medication documents.
     * @deny (create) - No one can create medication documents via the client.
     * @deny (update) - No one can update medication documents via the client.
     * @deny (delete) - No one can delete medication documents via the client.
     * @principle Allows public read access to medications, but restricts writes.
     */
    match /medications/{medicationId} {
      allow get: if true;
      allow list: if true;

      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Defines the rules for telehealthSession documents.
     * @path /telehealthSessions/{telehealthSessionId}
     * @allow (create) - No one can create telehealthSession documents via the client. // TODO: Add validation once the schema is updated with an ownership field.
     * @allow (read) - Anyone can read telehealthSession documents.
     * @allow (update) - No one can update telehealthSession documents via the client. // TODO: Add validation once the schema is updated with an ownership field.
     * @allow (delete) - No one can delete telehealthSession documents via the client. // TODO: Add validation once the schema is updated with an ownership field.
     * @allow (list) - Anyone can list telehealthSession documents.
     * @principle Allows public read access to telehealthSession, but restricts writes.
     */
    match /telehealthSessions/{telehealthSessionId} {
      allow get: if true;
      allow list: if true;

      allow create: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Defines the rules for imageStudy documents within a patient's subcollection.
     * @path /patients/{patientId}/imageStudies/{imageStudyId}
     * @allow (create) - Authenticated user can create an imageStudy document under their patient document if they are the patient.
     * @allow (read) - Authenticated user can read an imageStudy document under their patient document if they are the patient.
     * @allow (update) - Authenticated user can update an imageStudy document under their patient document if they are the patient.
     * @allow (delete) - Authenticated user can delete an imageStudy document under their patient document if they are the patient.
     * @deny (create) - Authenticated user cannot create an imageStudy document if they are not the patient.
     * @deny (read) - Authenticated user cannot read an imageStudy document if they are not the patient.
     * @deny (update) - Authenticated user cannot update an imageStudy document if they are not the patient.
     * @deny (delete) - Authenticated user cannot delete an imageStudy document if they are not the patient.
     * @principle Restricts access to imageStudy documents to the associated patient.
     */
    match /patients/{patientId}/imageStudies/{imageStudyId} {
      allow get: if isOwner(patientId);
      allow list: if isOwner(patientId);

      allow create: if isOwner(patientId) && request.resource.data.patientId == patientId;
      allow update: if isExistingOwner(patientId) && request.resource.data.patientId == resource.data.patientId;
      allow delete: if isExistingOwner(patientId);
    }
  }
}
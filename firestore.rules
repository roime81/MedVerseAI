rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Patients collection
    match /patients/{patientId} {
      // Anyone can create a patient for now, but in a real app you'd restrict this.
      allow create: if isSignedIn();

      // Only authenticated users can read, update, or delete patient records.
      // You would likely add more specific ownership-based rules here.
      allow read, update, delete: if isSignedIn();

      // Sub-collections for patient-related data
      match /encounters/{encounterId} {
        allow read, write: if isSignedIn();
      }

      match /conditions/{conditionId} {
        allow read, write: if isSignedIn();
      }

      match /observations/{observationId} {
        allow read, write: if isSignedIn();
      }

      match /measurements/{measurementId} {
        allow read, write: if isSignedIn();
      }

      match /drugExposures/{drugExposureId} {
        allow read, write: if isSignedIn();
      }
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Patients collection
    match /patients/{patientId} {
      allow create, read, update, delete: if isSignedIn();

      // Sub-collections for patient-related data
      match /encounters/{encounterId} {
        allow read, write: if isSignedIn();
      }

      match /conditions/{conditionId} {
        allow read, write: if isSignedIn();
      }

      match /observations/{observationId} {
        allow read, write: if isSignedIn();
      }

      match /measurements/{measurementId} {
        allow read, write: if isSignedIn();
      }

      match /drugExposures/{drugExposureId} {
        allow read, write: if isSignedIn();
      }
    }
    
    // Rules for collection group queries
    match /{path=**}/encounters/{encounterId} {
      allow list: if isSignedIn();
    }
    match /{path=**}/conditions/{conditionId} {
      allow list: if isSignedIn();
    }
    match /{path=**}/observations/{observationId} {
      allow list: if isSignedIn();
    }
    match /{path=**}/measurements/{measurementId} {
      allow list: if isSignedIn();
    }
    match /{path=**}/drugExposures/{drugExposureId} {
      allow list: if isSignedIn();
    }

    // Beds collection for occupancy management
    match /beds/{bedId} {
      allow read, write: if isSignedIn();
    }

    // CareSites collection for hospital information
    match /careSites/{careSiteId} {
      allow read: if isSignedIn();
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      // A user can create their own document if the document's uid matches their auth uid.
      allow create: if isOwner(request.resource.data.uid);
      allow update: if isOwner(userId);
    }
    
    // Patients collection
    match /patients/{patientId} {
      allow create, read, update, delete: if isSignedIn();

      // Sub-collections for patient-related data
      match /encounters/{encounterId} {
        allow read, write: if isSignedIn();
      }

      match /conditions/{conditionId} {
        allow read, write: if isSignedIn();
      }

      match /drugExposures/{drugExposureId} {
        allow read, write: if isSignedIn();
      }

      match /costs/{costId} {
        allow read, write: if isSignedIn();
      }

      match /payerPlanPeriods/{payerPlanPeriodId} {
        allow read, write: if isSignedIn();
      }

      match /visitDetails/{visitDetailId} {
        allow read, write: if isSignedIn();
      }
      
      match /clinicalNotes/{noteId} {
        allow read, write: if isSignedIn();
      }

      match /procedures/{procedureId} {
        allow read, write: if isSignedIn();
      }
      
      match /labResults/{labResultId} {
        allow read, write: if isSignedIn();
      }
      
      match /imagingStudies/{imagingStudyId} {
        allow read, write: if isSignedIn();
      }
    }
    
    // Rules for collection group queries
    match /{path=**}/encounters/{encounterId} {
      allow list: if isSignedIn();
    }
    match /{path=**}/conditions/{conditionId} {
      allow list: if isSignedIn();
    }
    match /{path=**}/drugExposures/{drugExposureId} {
      allow list: if isSignedIn();
    }
    match /{path=**}/costs/{costId} {
      allow list: if isSignedIn();
    }
    match /{path=**}/payerPlanPeriods/{payerPlanPeriodId} {
      allow list: if isSignedIn();
    }
    match /{path=**}/visitDetails/{visitDetailId} {
      allow list: if isSignedIn();
    }
    match /{path=**}/clinicalNotes/{noteId} {
      allow list: if isSignedIn();
    }
    match /{path=**}/procedures/{procedureId} {
      allow list: if isSignedIn();
    }
    match /{path=**}/labResults/{labResultId} {
      allow list: if isSignedIn();
    }
    match /{path=**}/imagingStudies/{imagingStudyId} {
      allow list: if isSignedIn();
    }


    // Beds collection for occupancy management
    match /beds/{bedId} {
      allow read, write: if isSignedIn();
    }

    // CareSites collection for hospital information
    match /careSites/{careSiteId} {
      allow read: if isSignedIn();
    }
    
    // Procedures collection for all procedures
    match /procedures/{procedureId} {
        allow read, write: if isSignedIn();
    }
    
    // Order Sets & Common Orders
    match /orderSets/{orderSetId} {
        allow read: if isSignedIn();
    }
    
    match /commonOrders/{orderId} {
        allow read: if isSignedIn();
    }
  }
}

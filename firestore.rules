rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Allow signed-in users to read from any of these collections
    match /{collection}/{document=**} {
      allow read: if isSignedIn() && collection in ['patients', 'wards', 'tasks', 'staffProfiles'];
      allow write: if false; // Default to no write access from client
    }
  }
}
